{
  "name": "soundlab-stem-split",
  "private": true,
  "version": "0.1.0",
  "description": "SoundLab Stem Split: split a mix into stems in the browser, as part of the SoundLab Pro family.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
