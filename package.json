    "test:model": "node --import ./tests/register.mjs tests-model/model.check.mjs"
  },
  "engines": {
    "node": ">=22.6"
  },
  "dependencies": {
    "@soundlab/design": "github:Stephanizzler/SoundLab-Core#7bd83cbeee1af009867c33dd6122b005d3f2ad45&path:/packages/design",
